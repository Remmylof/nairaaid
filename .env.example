# Copy to .env and fill in. NEVER commit .env.
DEPLOYER_PRIVATE_KEY=

# Token used by campaigns. Leave empty to deploy MockCNGN (testnets only).
# On mainnet/testnet with a real cNGN deployment, put its address here.
CNGN_ADDRESS=
# Optional: mint this many MockCNGN (whole naira) to the deployer for demos
MOCK_MINT_NGN=1000000

# RPCs (defaults are public endpoints)
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=
